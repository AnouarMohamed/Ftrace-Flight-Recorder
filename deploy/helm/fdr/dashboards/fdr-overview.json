{
  "annotations": {
    "list": []
  },
  "description": "Recorder health, evidence integrity, and capture throughput for FDR.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Ready means collectors are alive, probes succeeded, and no trace loss has been observed since startup or reload.",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {"color": "red", "index": 0, "text": "NOT READY"},
                "1": {"color": "green", "index": 1, "text": "READY"}
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "value_and_name",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "min(fdr_ready{namespace=~\"$namespace\",pod=~\"$pod\"})",
          "legendFormat": "Fleet",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Recorder readiness",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Any non-zero value means the retained trace is incomplete.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "decimals": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1}
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0},
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(increase(fdr_trace_overruns_total{namespace=~\"$namespace\",pod=~\"$pod\"}[5m]) + increase(fdr_trace_dropped_events_total{namespace=~\"$namespace\",pod=~\"$pod\"}[5m]) + increase(fdr_trace_commit_overruns_total{namespace=~\"$namespace\",pod=~\"$pod\"}[5m]))",
          "legendFormat": "Lost events",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Kernel trace loss, 5m",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Bytes deliberately discarded because the destination filesystem reached minfree.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "decimals": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "orange", "value": 1}
            ]
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0},
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(increase(fdr_bytes_dropped_total{namespace=~\"$namespace\",pod=~\"$pod\"}[5m]))",
          "legendFormat": "Dropped bytes",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Storage-protection drops, 5m",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "New persistence and probe configuration failures during the last five minutes.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "decimals": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1}
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0},
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(increase(fdr_write_errors_total{namespace=~\"$namespace\",pod=~\"$pod\"}[5m]) + increase(fdr_probe_failures_total{namespace=~\"$namespace\",pod=~\"$pod\"}[5m]) + increase(fdr_rotation_failures_total{namespace=~\"$namespace\",pod=~\"$pod\"}[5m]))",
          "legendFormat": "Failures",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Recorder failures, 5m",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Persisted trace throughput by FDR pod.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 12,
            "gradientMode": "none",
            "hideFrom": {"legend": false, "tooltip": false, "viz": false},
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 4,
            "scaleDistribution": {"type": "linear"},
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {"group": "A", "mode": "none"},
            "thresholdsStyle": {"mode": "off"}
          },
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]},
          "unit": "Bps"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "id": 5,
      "options": {
        "legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (pod) (rate(fdr_bytes_written_total{namespace=~\"$namespace\",pod=~\"$pod\"}[1m]))",
          "legendFormat": "{{pod}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Capture throughput",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Cumulative kernel loss counters. A rising line marks incomplete evidence.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "events",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 6,
            "gradientMode": "none",
            "hideFrom": {"legend": false, "tooltip": false, "viz": false},
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "pointSize": 4,
            "scaleDistribution": {"type": "linear"},
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {"group": "A", "mode": "none"},
            "thresholdsStyle": {"mode": "off"}
          },
          "decimals": 0,
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
      "id": 6,
      "options": {
        "legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {"editorMode": "code", "expr": "sum(fdr_trace_overruns_total{namespace=~\"$namespace\",pod=~\"$pod\"})", "legendFormat": "Overwritten", "range": true, "refId": "A"},
        {"editorMode": "code", "expr": "sum(fdr_trace_dropped_events_total{namespace=~\"$namespace\",pod=~\"$pod\"})", "legendFormat": "Dropped", "range": true, "refId": "B"},
        {"editorMode": "code", "expr": "sum(fdr_trace_commit_overruns_total{namespace=~\"$namespace\",pod=~\"$pod\"})", "legendFormat": "Commit overruns", "range": true, "refId": "C"}
      ],
      "title": "Trace integrity counters",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Configured instances and live collector workers should remain equal.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "count",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 6,
            "gradientMode": "none",
            "hideFrom": {"legend": false, "tooltip": false, "viz": false},
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "pointSize": 4,
            "scaleDistribution": {"type": "linear"},
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {"group": "A", "mode": "none"},
            "thresholdsStyle": {"mode": "off"}
          },
          "decimals": 0,
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 13},
      "id": 7,
      "options": {
        "legend": {"calcs": ["lastNotNull"], "displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {"editorMode": "code", "expr": "sum(fdr_instances{namespace=~\"$namespace\",pod=~\"$pod\"})", "legendFormat": "Configured instances", "range": true, "refId": "A"},
        {"editorMode": "code", "expr": "sum(fdr_workers_alive{namespace=~\"$namespace\",pod=~\"$pod\"})", "legendFormat": "Live workers", "range": true, "refId": "B"}
      ],
      "title": "Collector coverage",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Operational changes that can explain discontinuities in a capture.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "count",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 6,
            "gradientMode": "none",
            "hideFrom": {"legend": false, "tooltip": false, "viz": false},
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "pointSize": 4,
            "scaleDistribution": {"type": "linear"},
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {"group": "A", "mode": "none"},
            "thresholdsStyle": {"mode": "off"}
          },
          "decimals": 0,
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 13},
      "id": 8,
      "options": {
        "legend": {"calcs": ["lastNotNull"], "displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {"editorMode": "code", "expr": "sum(fdr_rotations_total{namespace=~\"$namespace\",pod=~\"$pod\"})", "legendFormat": "Rotations", "range": true, "refId": "A"},
        {"editorMode": "code", "expr": "sum(fdr_reloads_total{namespace=~\"$namespace\",pod=~\"$pod\"})", "legendFormat": "Reloads", "range": true, "refId": "B"},
        {"editorMode": "code", "expr": "sum(fdr_rotation_failures_total{namespace=~\"$namespace\",pod=~\"$pod\"})", "legendFormat": "Rotation failures", "range": true, "refId": "C"}
      ],
      "title": "Capture lifecycle",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",

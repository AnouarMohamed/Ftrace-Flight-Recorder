{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "image",
    "http",
    "preflight",
    "config",
    "tracefs",
    "modules",
    "logs",
    "monitoring",
    "networkPolicy"
  ],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "http": {
      "type": "object",
      "required": ["enabled", "address", "port"],
      "properties": {
        "enabled": {"type": "boolean"},
        "address": {
          "type": "string",
          "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}$"
        },
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "preflight": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"}
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "tolerations": {
      "type": "array",
      "items": {"type": "object"}
    },
    "config": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string"}
    },
    "tracefs": {"$ref": "#/definitions/hostPath"},
    "modules": {
      "allOf": [
        {"$ref": "#/definitions/hostPath"},
        {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": {"type": "boolean"}
          }
        }
      ]
    },
    "logs": {"$ref": "#/definitions/hostPath"},
    "monitoring": {
      "type": "object",
      "required": ["podMonitor"],
      "properties": {
        "podMonitor": {
          "type": "object",
          "required": [
            "enabled",
            "namespace",
            "interval",
            "scrapeTimeout",
            "additionalLabels"
          ],
          "properties": {
            "enabled": {"type": "boolean"},
            "namespace": {"type": "string"},
            "interval": {
              "type": "string",
              "pattern": "^[0-9]+(ms|s|m|h)$"
            },
            "scrapeTimeout": {
              "type": "string",
              "pattern": "^[0-9]+(ms|s|m|h)$"
            },
            "additionalLabels": {
              "type": "object",
              "additionalProperties": {"type": "string"}
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": ["enabled", "ingress"],
      "properties": {
        "enabled": {"type": "boolean"},
        "ingress": {
          "type": "object",
          "required": ["namespaceSelector", "podSelector"],
          "properties": {
            "namespaceSelector": {"type": "object"},
            "podSelector": {"type": "object"}
          }
        }
      }
    }
  },
  "definitions": {
    "hostPath": {
      "type": "object",
      "required": ["hostPath"],
      "properties": {
        "hostPath": {"type": "string", "pattern": "^/"}
      }
    }
  }
}
